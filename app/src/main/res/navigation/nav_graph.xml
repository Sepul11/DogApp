<?xml version="1.0" encoding="utf-8"?>
<!-- Compartido: destinos de HU-1 a HU-5; Login es la entrada inicial. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.dogapp.ui.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login" />

    <!-- HU-2 inicia creación (HU-3) o consulta de detalle (HU-4). -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.dogapp.ui.home.HomeFragment"
        android:label="Administrador de Citas"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_nuevaCitaFragment"
            app:destination="@id/nuevaCitaFragment" />

        <action
            android:id="@+id/action_homeFragment_to_detalleFragment"
            app:destination="@id/detalleFragment" />

    </fragment>

    <fragment
        android:id="@+id/nuevaCitaFragment"
        android:name="com.example.dogapp.ui.nuevacita.NuevaCitaFragment"
        android:label="Nueva Cita"
        tools:layout="@layout/fragment_nueva_cita" />

    <!-- HU-4 recibe el ID persistido; el mismo argumento se envia a HU-5. -->
    <fragment
        android:id="@+id/detalleFragment"
        android:name="com.example.dogapp.ui.detalle.DetalleFragment"
        android:label="Detalle"
        tools:layout="@layout/fragment_detalle">

        <argument
            android:name="citaId"
            app:argType="integer" />

        <action
            android:id="@+id/action_detalleFragment_to_editarCitaFragment"
            app:destination="@id/editarCitaFragment"/>

    </fragment>

    <!-- HU-5 retira Editar y Detalle tras actualizar; popBackStack se solicita en Kotlin. -->
    <fragment
        android:id="@+id/editarCitaFragment"
        android:name="com.example.dogapp.ui.editarcita.EditarCitaFragment"
        android:label="Editar Cita"
        tools:layout="@layout/fragment_editar_cita">

        <argument
            android:name="citaId"
            app:argType="integer" />

    </fragment>
</navigation>