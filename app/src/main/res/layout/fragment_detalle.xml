<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F9F6FA">

        <!-- Toolbar Superior con el Nombre de la Mascota -->
        <FrameLayout
            android:id="@+id/toolbarDetalle"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_toolbar_nueva_cita"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnVolver"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/volver_home"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_arrow_back"
                app:tint="@color/appointment_pink" />

            <TextView
                android:id="@+id/tvTituloDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Cory" />

        </FrameLayout>

        <!-- Contenido principal -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/toolbarDetalle"
            app:layout_constraintBottom_toTopOf="@id/layoutBotones"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="36dp"
                android:paddingBottom="24dp">

                <!-- Tarjeta Blanca de Detalles -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="60dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="90dp"
                        android:paddingBottom="32dp">

                        <!-- Número de Turno #1 en rojo a la derecha -->
                        <TextView
                            android:id="@+id/tvTurnoDetalle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/appointment_pink"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            tools:text="#1" />

                        <!-- Raza en negrita centrada -->
                        <TextView
                            android:id="@+id/tvRazaDetalle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="#333333"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            tools:text="pitbull" />

                        <!-- Síntoma en texto secundario debajo de la raza -->
                        <TextView
                            android:id="@+id/tvSintomaDetalle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="#757575"
                            android:textSize="15sp"
                            app:layout_constraintTop_toBottomOf="@id/tvRazaDetalle"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            tools:text="Tiene garrapatas" />

                        <!-- Línea Divisora Rosada -->
                        <View
                            android:id="@+id/divider"
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="20dp"
                            android:background="@color/appointment_pink"
                            app:layout_constraintTop_toBottomOf="@id/tvSintomaDetalle"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Propietario -->
                        <TextView
                            android:id="@+id/tvNombrePropietarioDetalle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:textColor="#424242"
                            android:textSize="16sp"
                            app:layout_constraintTop_toBottomOf="@id/divider"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            tools:text="Propietario: Walter" />

                        <!-- Teléfono -->
                        <TextView
                            android:id="@+id/tvTelefonoDetalle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textColor="#424242"
                            android:textSize="16sp"
                            app:layout_constraintTop_toBottomOf="@id/tvNombrePropietarioDetalle"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            tools:text="Teléfono: 3045675518" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Tarjeta de Imagen que sobresale centrada -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardImagen"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    app:strokeWidth="4dp"
                    app:strokeColor="@color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivDetalleMascota"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no"
                        tools:src="@drawable/dog_head" />

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

        <!-- Botones Flotantes en la parte inferior (Caneca y Lápiz) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutBotones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="24dp"
            android:paddingTop="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Botón Eliminar (Rojo / Caneca) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnEliminarCita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/btn_eliminar_cita"
                app:srcCompat="@android:drawable/ic_menu_delete"
                app:tint="@color/white"
                app:backgroundTint="@color/appointment_pink"
                app:fabSize="normal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Botón Editar (Oscuro / Lápiz) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnEditarCita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/btn_editar_cita"
                app:srcCompat="@android:drawable/ic_menu_edit"
                app:tint="@color/white"
                app:backgroundTint="@color/login_background"
                app:fabSize="normal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>