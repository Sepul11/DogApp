<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- HU-1: Data Binding conecta el ViewModel con enabled en la huella. -->
    <data>
        <variable
            name="viewModel"
            type="com.example.dogapp.viewmodel.LoginViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/login_background"
        tools:context=".ui.login.LoginFragment">

        <ImageView
            android:id="@+id/dogImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="-30dp"
            android:rotation="-25"
            android:contentDescription="@string/login_dog_description"
            android:scaleType="fitCenter"
            android:src="@drawable/dog_head"
            android:translationX="56dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintWidth_percent="0.75" />

        <TextView
            android:id="@+id/brandTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/login_brand"
            android:textColor="@color/login_text"
            android:textSize="70sp"
            android:fontFamily="@font/fredoka_boldd"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dogImage" />

        <!-- Animación que recibe el clic; BiometricPrompt realiza la autenticación real. -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/fingerprintAnimation"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="48dp"
            android:contentDescription="@string/login_fingerprint_description"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/brandTitle"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintWidth_max="150dp"
            app:layout_constraintWidth_percent="0.30"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/fingerprint"
            android:enabled="@{!viewModel.autenticando}"
            android:clickable="true"
            android:focusable="true" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>